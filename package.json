{
  "name": "@engine262/engine262",
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.5",
  "description": "Implementation of ECMA-262 in JavaScript",
  "author": "engine262 Contributors",
  "license": "MIT",
  "homepage": "https://github.com/engine262/engine262#readme",
  "bugs": {
    "url": "https://github.com/engine262/engine262/issues"
  },
  "main": "lib/engine262.js",
  "types": "./declaration/index.d.mts",
  "imports": {
    "#self": {
      "rollup": "./src/index.mts",
      "types": "./declaration/index.d.mts",
      "default": "./lib/engine262.mjs"
    },
    "#self/inspector": {
      "types": "./lib/inspector/index.d.mts",
      "default": "./lib/inspector.mjs"
    }
  },
  "exports": {
    ".": {
      "require": {
        "types": "./declaration/index.d.mts",
        "default": "./lib/engine262.js"
      },
      "import": {
        "types": "./declaration/index.d.mts",
        "default": "./lib/engine262.mjs"
      }
    },
    "./inspector": {
      "require": {
        "types": "./declaration-inspector/index.d.mts",
        "default": "./lib/inspector.js"
      },
      "import": {
        "types": "./declaration-inspector/index.d.mts",
        "default": "./lib/inspector.mjs"
      }
    },
    "./lib/": "./lib/"
  },
  "scripts": {
    "start": "node --enable-source-maps ./lib-src/node/bin.mts",
    "inspector": "node ./website/scripts/serve.mts",
    "lint": "pnpm run build:packages && eslint test/ src/ bin/ lib-src/ scripts/ packages/ --cache",
    "lint:fix": "pnpm run lint -- --fix",
    "prebuild:err": "node scripts/generate_error_message_hint.mts",
    "prebuild:bundle_test262_harness": "node scripts/bundle_test262_harness.mts",
    "watch": "run-p \"watch:*\"",
    "build": "run-s build:packages prebuild:bundle_test262_harness prebuild:err build:regex_data build:dts build:engine",
    "build:packages": "pnpm --filter './packages/*' run build",
    "api:baseline": "run-s build:dts api:bundle",
    "api:bundle": "api-extractor run --local --config config/api-extractor/src.json && api-extractor run --local --config config/api-extractor/inspector.json && api-extractor run --local --config config/api-extractor/node.json",
    "api:check": "pnpm run api:baseline && test -z \"$(git status --porcelain -- api-baseline)\"",
    "build:regex_data": "node scripts/gen_regex_sets.mts",
    "build:dts": "tsgo -b .",
    "watch:dts": "tsgo -b . -w",
    "build:engine": "rollup -c ./scripts/rollup.config.mts",
    "watch:engine": "pnpm run build:engine --watch",
    "spec:update": "node scripts/update_spec.mts",
    "test": "run-s -c test:inspector test:owned test:json test:test262",
    "test:test262": "node test/test262/test262.mts",
    "test:owned": "vitest test/engine262 --watch=false",
    "test:owned:watch": "vitest test/engine262",
    "test:json": "node test/json/json.mts",
    "test:inspector": "vitest test/inspector --watch=false",
    "test:inspector:watch": "vitest test/inspector",
    "coverage": "c8 --reporter=lcov pnpm run test",
    "test:packages": "pnpm --filter './packages/*' run test",
    "prepublishOnly": "node scripts/tag_version_with_git_hash.mts",
    "postpublish": "git reset --hard HEAD"
  },
  "bin": {
    "engine262": "lib/node/bin.mjs"
  },
  "files": [
    "bin",
    "declaration",
    "declaration-inspector",
    "!declaration/.tsbuildinfo",
    "!lib/node/.tsbuildinfo",
    "!lib/node/tsconfig.json",
    "!lib/inspector/.tsbuildinfo",
    "!lib/inspector/tsconfig.json",
    "lib",
    "src",
    "lib-src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/engine262/engine262.git"
  },
  "peerDependencies": {
    "ws": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/code-frame": "^8.0.0",
    "@babel/core": "^8.0.0",
    "@babel/plugin-proposal-decorators": "^8.0.0",
    "@babel/plugin-transform-explicit-resource-management": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@babel/preset-typescript": "^8.0.0",
    "@engine262/babel-compiler": "workspace:*",
    "@engine262/eslint-plugin": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@magic-works/ariadne": "^0.6.0",
    "@microsoft/api-documenter": "^7.26.34",
    "@microsoft/api-extractor": "^7.59.1",
    "@pppp606/ink-chart": "^0.2.4",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/babel__code-frame": "^7.27.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.28.0",
    "@types/estree": "^1.0.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/utils": "^8.63.0",
    "@typescript/native-preview": "^7.0.0-dev.20260404.1",
    "@unicode/unicode-17.0.0": "^1.6.16",
    "@vitest/coverage-v8": "^4.1.2",
    "c8": "^11.0.0",
    "devtools-protocol": "^0.0.1608973",
    "eslint": "^10.7.0",
    "http-server": "^14.1.1",
    "ink": "6.6.0",
    "ink-task-list": "^2.0.0",
    "js-yaml": "^4.1.0",
    "jsbd": "^0.0.11",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.4",
    "rollup": "^4.54.0",
    "tinyglobby": "^0.2.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.2",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  }
}
