{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "composite": true,
    "rootDir": "./src",
    "outDir": "./lib",
    "tsBuildInfoFile": "./lib/.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "@engine262/babel-compiler": ["../babel-compiler/src/index.mts"],
      "#self": ["../../src/index.mts"]
    }
  },
  "include": ["./src/**/*.mts"],
  "references": [
    { "path": "../babel-compiler" }
  ]
}
